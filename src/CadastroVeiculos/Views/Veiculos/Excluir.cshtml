@model Veiculo
@{
    ViewData["Title"] = "Excluir veículo";
}

<h1>Excluir veículo</h1>

<div class="alert alert-warning mt-3">
    Tem certeza que deseja excluir este veículo? Essa ação não pode ser desfeita.
</div>

<dl class="row">
    <dt class="col-sm-2">Placa</dt>
    <dd class="col-sm-10">@Model.Placa</dd>

    <dt class="col-sm-2">Marca</dt>
    <dd class="col-sm-10">@Model.Marca</dd>

    <dt class="col-sm-2">Modelo</dt>
    <dd class="col-sm-10">@Model.Modelo</dd>

    <dt class="col-sm-2">Ano</dt>
    <dd class="col-sm-10">@Model.Ano</dd>

    <dt class="col-sm-2">Chassi</dt>
    <dd class="col-sm-10">@Model.Chassis</dd>
</dl>

<form asp-action="Excluir" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>