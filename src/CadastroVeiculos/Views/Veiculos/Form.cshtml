@model Veiculo
@using CadastroVeiculos.Services
@{
    bool edicao = Model.Id > 0;
    ViewData["Title"] = edicao ? "Editar veículo" : "Novo veículo";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Salvar" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Placa" class="form-label">Placa</label>
            <input asp-for="Placa" class="form-control" placeholder="ABC1D23" />
            <span asp-validation-for="Placa" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Chassis" class="form-label">Chassi</label>
            <input asp-for="Chassis" class="form-control" maxlength="17" />
            <span asp-validation-for="Chassis" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Marca" class="form-label">Marca</label>
            <input asp-for="Marca" class="form-control" />
            <span asp-validation-for="Marca" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Modelo" class="form-label">Modelo</label>
            <input asp-for="Modelo" class="form-control" />
            <span asp-validation-for="Modelo" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Cor" class="form-label">Cor</label>
            <input asp-for="Cor" class="form-control" />
            <span asp-validation-for="Cor" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Ano" class="form-label">Ano</label>
            <input asp-for="Ano" class="form-control" />
            <span asp-validation-for="Ano" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Porte" class="form-label">Porte</label>
            <select asp-for="Porte" class="form-select">
                <option value="">Selecione...</option>
                @foreach (var porte in VeiculoService.Portes)
                {
                    <option value="@porte">@porte</option>
                }
            </select>
            <span asp-validation-for="Porte" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="TipoCarga" class="form-label">Tipo de carga</label>
            <input asp-for="TipoCarga" class="form-control" />
            <span asp-validation-for="TipoCarga" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}